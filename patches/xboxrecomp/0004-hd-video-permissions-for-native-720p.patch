+++ b/src/kernel/kernel_xbox.c
@@ -10,6 +10,7 @@
  */
 
 #include "kernel.h"
+#include <stdlib.h>                     /* getenv: RECOMP_VIDEO_HD */
 #include <string.h>
 
 /* ============================================================================
@@ -125,6 +126,24 @@ NTSTATUS __stdcall xbox_XeUnloadSection(PXBE_SECTION_HEADER Section)
  *   - DVD Region: Region 1 (North America)
  * ============================================================================ */
 
+/* The user's HD video permissions, in the console's own layout: the EEPROM's
+ * video flags (XC_VIDEO) and the AV capabilities word D3D checks a mode
+ * against both carry them from bit 16 -- widescreen 0x00010000, 720p
+ * 0x00020000, 1080i 0x00040000, 480p 0x00080000. Without them D3D refuses
+ * every HD mode (CreateDevice fails) and XGetVideoFlags reports 4:3 SDTV.
+ * Off unless RECOMP_VIDEO_HD=1: a title that offers HD then switches to it,
+ * which changes its output resolution and layout. */
+ULONG xbox_VideoUserFlags(void)
+{
+    static int hd = -1;
+
+    if (hd < 0) {
+        const char *e = getenv("RECOMP_VIDEO_HD");
+        hd = e && *e == '1';
+    }
+    return hd ? 0x00010000u | 0x00020000u | 0x00080000u : 0;  /* widescreen, 720p, 480p */
+}
+
 NTSTATUS __stdcall xbox_ExQueryNonVolatileSetting(
     ULONG ValueIndex, PULONG Type, PVOID Value, ULONG ValueLength, PULONG ResultLength)
 {
@@ -147,7 +166,8 @@ NTSTATUS __stdcall xbox_ExQueryNonVolatileSetting(
     case XC_VIDEO:
         /* NTSC with widescreen and HDTV support enabled */
         if (ValueLength >= sizeof(ULONG)) {
-            *(PULONG)Value = XC_VIDEO_FLAGS_WIDESCREEN | XC_VIDEO_FLAGS_HDTV;
+            *(PULONG)Value = XC_VIDEO_FLAGS_WIDESCREEN | XC_VIDEO_FLAGS_HDTV
+                           | xbox_VideoUserFlags();
             if (Type) *Type = 4; /* REG_DWORD */
             if (ResultLength) *ResultLength = sizeof(ULONG);
         }
@@ -202,6 +222,17 @@ NTSTATUS __stdcall xbox_ExQueryNonVolatileSetting(
         }
         break;
 
+    case 0x103:
+        /* XC_FACTORY_AV_REGION: the factory video standard, NTSC-M 60 Hz --
+         * the standard AvSendTVEncoderOption reports. XAPI reads its second
+         * byte as the standard (it clears the HD flags on PAL). */
+        if (ValueLength >= sizeof(ULONG)) {
+            *(PULONG)Value = 0x00400100;
+            if (Type) *Type = 4;
+            if (ResultLength) *ResultLength = sizeof(ULONG);
+        }
+        break;
+
     default:
         xbox_log(XBOX_LOG_WARN, XBOX_LOG_XBOX,
             "ExQueryNonVolatileSetting: unhandled index 0x%02X", ValueIndex);
