+/* A texture's (or palette's) offset: the window whenever the arena handed
+ * that physical range out, whatever the RAM-name record says.
+ *
+ * XDK D3D allocates texture memory contiguously (XPhysicalAlloc), never from
+ * the general heap, so for a texture the window copy is the one meant. The
+ * RAM-name record cannot tell when both copies are live: Amped 2's face
+ * texture went to physical 0x01544900 after a ride while heap page 0x01544000,
+ * named through MmGetPhysicalAddress (sound data), was still allocated -- and
+ * the face sampled heap bytes as DXT, block noise. Vertex arrays keep
+ * dma_resolve: a title can place those in the heap. */
+static uint32_t dma_resolve_texture(uint32_t offset)
+{
+    extern uint32_t xbox_ContiguousAllocatedBytes(void);
+
+    if (offset < xbox_ContiguousAllocatedBytes())
+        return XBOX_CONTIG_BASE + offset;
+    return dma_resolve(offset);
+}
