 /* One pixel. Colours are r,g,b,a in [0,1]; `fog` is (fog colour, factor).
diff --git a/src/kernel/nv2a_overlay.c b/src/kernel/nv2a_overlay.c
new file mode 100644
index 0000000..b58a8d6
--- /dev/null
+++ b/src/kernel/nv2a_overlay.c
@@ -0,0 +1,341 @@
+/*
+ * nv2a_overlay.c -- the NV2A video overlay (PVIDEO). See nv2a_overlay.h.
+ *
+ * The register aperture is plain memory here (writes are not trapped), so
+ * the title's register writes are simply there to read at the next vblank.
+ * Register layout (NV2A PVIDEO, as xemu documents it), two buffers i = 0/1:
+ *   0x8100 INTR          0x8140 INTR_EN
+ *   0x8700 BUFFER        bit 0 = buffer 0 pending, bit 4 = buffer 1 pending
+ *   0x8704 STOP          bit 0 = stop the overlay
+ *   0x8900 + 4i BASE     0x8908 + 4i LIMIT
+ *   0x8920 + 4i OFFSET   physical offset of the frame (added to BASE)
+ *   0x8928 + 4i SIZE_IN  height << 16 | width
+ *   0x8930 + 4i POINT_IN source origin, 12.4 fixed point (t << 16 | s)
+ *   0x8938 + 4i DS_DX    0x8940 + 4i DT_DY   source step per output pixel, 12.20
+ *   0x8948 + 4i POINT_OUT  y << 16 | x      0x8950 + 4i SIZE_OUT  h << 16 | w
+ *   0x8958 + 4i FORMAT   bits 0-12 pitch; bit 16 colour (1 = YUY2, 0 = UYVY);
+ *                        bit 20 display only where the framebuffer is the
+ *                        colour key
+ *   0x8B00 COLOR_KEY
+ *
+ * The frame is copied out at the latch: once the pending bit is clear the
+ * title may reuse the buffer, exactly as on the console.
+ *
+ * RECOMP_OVERLAY_DUMP=<prefix> writes every 30th latched frame to
+ * <prefix>NNNNN.bmp (converted, unscaled), to check movies without a display.
+ */
+#include "nv2a_overlay.h"
+
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern ptrdiff_t xbox_GetMemoryOffset(void);
+
+#define NV2A_REG_BASE        0xFD000000u
+#define PVIDEO_BUFFER        0x8700u
+#define PVIDEO_STOP          0x8704u
+#define PVIDEO_BASE(i)       (0x8900u + 4u * (i))
+#define PVIDEO_LIMIT(i)      (0x8908u + 4u * (i))
+#define PVIDEO_OFFSET(i)     (0x8920u + 4u * (i))
+#define PVIDEO_SIZE_IN(i)    (0x8928u + 4u * (i))
+#define PVIDEO_POINT_IN(i)   (0x8930u + 4u * (i))
+#define PVIDEO_DS_DX(i)      (0x8938u + 4u * (i))
+#define PVIDEO_DT_DY(i)      (0x8940u + 4u * (i))
+#define PVIDEO_POINT_OUT(i)  (0x8948u + 4u * (i))
+#define PVIDEO_SIZE_OUT(i)   (0x8950u + 4u * (i))
+#define PVIDEO_FORMAT(i)     (0x8958u + 4u * (i))
+#define PVIDEO_COLOR_KEY     0x8B00u
+
+#define FMT_PITCH_MASK       0x1FFFu
+#define FMT_COLOR_YUY2       (1u << 16)
+#define FMT_DISPLAY_KEYED    (1u << 20)
+
+/* Guest physical memory is reachable through the contiguous window. */
+#define CONTIG_WINDOW        0x80000000u
+#define MAX_W                1024u
+#define MAX_H                1024u
+
+static volatile uint32_t *reg(uint32_t off)
+{
+    return (volatile uint32_t *)((uintptr_t)(NV2A_REG_BASE + off)
+                                 + xbox_GetMemoryOffset());
+}
+
+#ifdef _WIN32
+#include <windows.h>
+static SRWLOCK s_lock_obj = SRWLOCK_INIT;
+#define LOCK()   AcquireSRWLockExclusive(&s_lock_obj)
+#define UNLOCK() ReleaseSRWLockExclusive(&s_lock_obj)
+#else
+#include <pthread.h>
+static pthread_mutex_t s_lock_obj = PTHREAD_MUTEX_INITIALIZER;
+#define LOCK()   pthread_mutex_lock(&s_lock_obj)
+#define UNLOCK() pthread_mutex_unlock(&s_lock_obj)
+#endif
+
+/* The latched frame. */
+static uint8_t  *s_px;               /* w * h * 2 bytes, packed */
+static uint32_t *s_rgb;              /* the same frame as XRGB8888, w * h */
+static uint32_t  s_w, s_h, s_yuy2, s_keyed, s_key;
+static uint32_t  s_out_x, s_out_y, s_out_w, s_out_h;
+static uint32_t  s_in_s, s_in_t, s_ds_dx, s_dt_dy;
+static volatile uint64_t s_seq;
+static volatile int s_active;
+
+uint64_t nv2a_overlay_seq(void) { return s_seq; }
+int nv2a_overlay_active(void)   { return s_active; }
+
+static inline uint32_t clamp8(int v)
+{
+    return v < 0 ? 0u : v > 255 ? 255u : (uint32_t)v;
+}
+
+/* BT.601 studio range, as the NV2A's overlay converter. Table-driven: the
+ * per-component products are looked up, so a pixel costs adds and clamps. */
+static int s_lut_y[256], s_lut_rv[256], s_lut_gu[256], s_lut_gv[256], s_lut_bu[256];
+static int s_lut_ready;
+
+static void lut_init(void)
+{
+    int i;
+    for (i = 0; i < 256; i++) {
+        s_lut_y[i]  = (i - 16) * 298 + 128;
+        s_lut_rv[i] = 409 * (i - 128);
+        s_lut_gu[i] = -100 * (i - 128);
+        s_lut_gv[i] = -208 * (i - 128);
+        s_lut_bu[i] = 516 * (i - 128);
+    }
+    s_lut_ready = 1;
+}
+
+static inline uint32_t yuv_to_xrgb(int y, int u, int v)
+{
+    int c = s_lut_y[y];
+    return clamp8((c + s_lut_rv[v]) >> 8) << 16
+         | clamp8((c + s_lut_gu[u] + s_lut_gv[v]) >> 8) << 8
+         | clamp8((c + s_lut_bu[u]) >> 8);
+}
+
+/* Pixel x of row `row` (packed 4:2:2, two pixels per 4 bytes). */
+static inline uint32_t fetch(const uint8_t *row, uint32_t x, uint32_t yuy2)
+{
+    const uint8_t *p = row + (x & ~1u) * 2u;
+    int y, u, v;
+    if (yuy2) {                               /* Y0 U Y1 V */
+        y = p[(x & 1u) ? 2 : 0]; u = p[1]; v = p[3];
+    } else {                                  /* U Y0 V Y1 */
+        y = p[(x & 1u) ? 3 : 1]; u = p[0]; v = p[2];
+    }
+    return yuv_to_xrgb(y, u, v);
+}
+
+static void dump_frame(void)
+{
+    static const char *prefix;
+    static int checked;
+    static unsigned n;
+    char path[512];
+    FILE *f;
+    uint32_t x, y, row_bytes, file_size;
+    uint8_t hdr[54];
+
+    if (!checked) {
+        checked = 1;
+        prefix = getenv("RECOMP_OVERLAY_DUMP");
+    }
+    if (!prefix || !*prefix || (s_seq % 30u) != 1u)
+        return;
+    snprintf(path, sizeof path, "%s%05u.bmp", prefix, n++);
+    f = fopen(path, "wb");
+    if (!f)
+        return;
+    row_bytes = (s_w * 3u + 3u) & ~3u;
+    file_size = 54u + row_bytes * s_h;
+    memset(hdr, 0, sizeof hdr);
+    hdr[0] = 'B'; hdr[1] = 'M';
+    memcpy(hdr + 2, &file_size, 4);
+    hdr[10] = 54; hdr[14] = 40;
+    memcpy(hdr + 18, &s_w, 4);
+    memcpy(hdr + 22, &s_h, 4);
+    hdr[26] = 1; hdr[28] = 24;
+    fwrite(hdr, 1, sizeof hdr, f);
+    for (y = s_h; y-- > 0;) {                 /* BMP rows bottom-up */
+        uint8_t line[MAX_W * 3u + 4u];
+        const uint8_t *row = s_px + (size_t)y * s_w * 2u;
+        memset(line, 0, row_bytes);
+        for (x = 0; x < s_w; x++) {
+            uint32_t c = fetch(row, x, s_yuy2);
+            line[x * 3u + 0] = (uint8_t)c;
+            line[x * 3u + 1] = (uint8_t)(c >> 8);
+            line[x * 3u + 2] = (uint8_t)(c >> 16);
+        }
+        fwrite(line, 1, row_bytes, f);
+    }
+    fclose(f);
+}
+
+void nv2a_overlay_vblank(void)
+{
+    uint32_t buffer, stop, i, fmt, size_in, w, h, pitch, src_va, y;
+    const uint8_t *src;
+
+    if (!xbox_GetMemoryOffset())
+        return;
+
+    stop = *reg(PVIDEO_STOP);
+    if (stop & 1u) {
+        /* The title switched the overlay off (D3DDevice_EnableOverlay(FALSE)
+         * / XMV teardown). Consume the command and stop showing it. */
+        *reg(PVIDEO_STOP) = 0;
+        *reg(PVIDEO_BUFFER) = 0;
+        if (s_active) {
+            s_active = 0;
+            s_seq++;
+        }
+        return;
+    }
+
+    buffer = *reg(PVIDEO_BUFFER);
+    if (!(buffer & 0x11u))
+        return;
+    i = (buffer & 0x10u) ? 1u : 0u;
+
+    fmt = *reg(PVIDEO_FORMAT(i));
+    size_in = *reg(PVIDEO_SIZE_IN(i));
+    w = size_in & 0x7FFu;
+    h = (size_in >> 16) & 0x7FFu;
+    pitch = fmt & FMT_PITCH_MASK;
+    src_va = CONTIG_WINDOW
+           | ((*reg(PVIDEO_BASE(i)) + *reg(PVIDEO_OFFSET(i))) & 0x07FFFFFFu);
+
+    /* The buffer is ours now: tell the title, as the hardware does. */
+    *reg(PVIDEO_BUFFER) = buffer & ~(i ? 0x10u : 0x01u);
+
+    if (!w || !h || w > MAX_W || h > MAX_H || pitch < w * 2u)
+        return;
+
+    LOCK();
+    if (!s_px) {
+        s_px = (uint8_t *)malloc((size_t)MAX_W * MAX_H * 2u);
+        s_rgb = (uint32_t *)malloc((size_t)MAX_W * MAX_H * 4u);
+        if (!s_px || !s_rgb) {
+            free(s_px); free(s_rgb);
+            s_px = NULL; s_rgb = NULL;
+        }
+    }
+    if (!s_lut_ready)
+        lut_init();
+    if (s_px) {
+        int changed = !s_active || w != s_w || h != s_h
+                   || (((fmt & FMT_COLOR_YUY2) != 0) != (s_yuy2 != 0));
+        src = (const uint8_t *)((uintptr_t)src_va + xbox_GetMemoryOffset());
+        /* Titles re-submit the frame they already showed every vblank (XMV
+         * does until its clock says the next one is due): only a real change
+         * is a new frame, worth converting and presenting again. */
+        for (y = 0; y < h; y++) {
+            uint8_t *dst_row = s_px + (size_t)y * w * 2u;
+            const uint8_t *src_row = src + (size_t)y * pitch;
+            if (!changed && memcmp(dst_row, src_row, (size_t)w * 2u) == 0)
+                continue;
+            changed = 1;
+            memcpy(dst_row, src_row, (size_t)w * 2u);
+        }
+        if (!changed) {
+            UNLOCK();
+            return;
+        }
+        s_w = w;
+        s_h = h;
+        s_yuy2 = (fmt & FMT_COLOR_YUY2) != 0;
+        s_keyed = (fmt & FMT_DISPLAY_KEYED) != 0;
+        s_key = *reg(PVIDEO_COLOR_KEY);
+        s_out_x = *reg(PVIDEO_POINT_OUT(i)) & 0xFFFu;
+        s_out_y = (*reg(PVIDEO_POINT_OUT(i)) >> 16) & 0xFFFu;
+        s_out_w = *reg(PVIDEO_SIZE_OUT(i)) & 0xFFFu;
+        s_out_h = (*reg(PVIDEO_SIZE_OUT(i)) >> 16) & 0xFFFu;
+        s_in_s = *reg(PVIDEO_POINT_IN(i)) & 0xFFFFu;
+        s_in_t = (*reg(PVIDEO_POINT_IN(i)) >> 16) & 0xFFFFu;
+        s_ds_dx = *reg(PVIDEO_DS_DX(i));
+        s_dt_dy = *reg(PVIDEO_DT_DY(i));
+        if (!s_out_w) s_out_w = w;
+        if (!s_out_h) s_out_h = h;
+        if (!s_ds_dx) s_ds_dx = 1u << 20;
+        if (!s_dt_dy) s_dt_dy = 1u << 20;
+        {
+            uint32_t x;
+            for (y = 0; y < h; y++) {
+                const uint8_t *row = s_px + (size_t)y * w * 2u;
+                uint32_t *out = s_rgb + (size_t)y * w;
+                for (x = 0; x < w; x++)
+                    out[x] = fetch(row, x, s_yuy2);
+            }
+        }
+        s_active = 1;
+        s_seq++;
+        if (s_seq == 1)
+            fprintf(stderr, "  [OVERLAY] first frame: %ux%u %s pitch %u from 0x%08X "
+                            "-> %ux%u at (%u,%u)%s\n",
+                    w, h, s_yuy2 ? "YUY2" : "UYVY", pitch, src_va,
+                    s_out_w, s_out_h, s_out_x, s_out_y,
+                    s_keyed ? ", colour-keyed" : "");
+        dump_frame();
+    }
+    UNLOCK();
+}
+
+int nv2a_overlay_compose_xrgb(uint32_t *dst, uint32_t w, uint32_t h,
+                              uint32_t pitch_px)
+{
+    uint32_t ox, oy, x, y;
+    uint64_t s0, t;
+    int unscaled;
+
+    if (!s_active || !dst)
+        return 0;
+    LOCK();
+    if (!s_rgb || !s_w || !s_h) {
+        UNLOCK();
+        return 0;
+    }
+    unscaled = s_ds_dx == (1u << 20) && s_dt_dy == (1u << 20)
+            && !s_in_s && !s_in_t && !s_keyed;
+    for (oy = 0; oy < s_out_h; oy++) {
+        uint32_t sy;
+        uint32_t *out;
+        const uint32_t *row;
+        y = s_out_y + oy;
+        if (y >= h)
+            break;
+        /* 12.4 origin + 12.20 step, in 12.20. */
+        t = ((uint64_t)s_in_t << 16) + (uint64_t)oy * s_dt_dy;
+        sy = (uint32_t)(t >> 20);
+        if (sy >= s_h)
+            sy = s_h - 1;
+        row = s_rgb + (size_t)sy * s_w;
+        out = dst + (size_t)y * pitch_px;
+        if (unscaled) {
+            uint32_t n = s_out_w;
+            if (n > s_w) n = s_w;
+            if (s_out_x + n > w) n = s_out_x < w ? w - s_out_x : 0;
+            memcpy(out + s_out_x, row, (size_t)n * 4u);
+            continue;
+        }
+        s0 = (uint64_t)s_in_s << 16;
+        for (ox = 0; ox < s_out_w; ox++) {
+            uint32_t sx;
+            x = s_out_x + ox;
+            if (x >= w)
+                break;
+            if (s_keyed && (out[x] & 0xFFFFFFu) != (s_key & 0xFFFFFFu))
+                continue;
+            sx = (uint32_t)((s0 + (uint64_t)ox * s_ds_dx) >> 20);
+            if (sx >= s_w)
+                sx = s_w - 1;
+            out[x] = row[sx];
+        }
+    }
+    UNLOCK();
+    return 1;
+}
diff --git a/src/kernel/nv2a_overlay.h b/src/kernel/nv2a_overlay.h
new file mode 100644
index 0000000..d4ab713
--- /dev/null
+++ b/src/kernel/nv2a_overlay.h
@@ -0,0 +1,45 @@
+/*
+ * nv2a_overlay.h -- the NV2A video overlay (PVIDEO), as far as titles use it.
+ *
+ * The XDK shows movies through the overlay, not through the 3D pipe:
+ * D3DDevice_UpdateOverlay writes a YUY2/UYVY surface's offset, size, scale and
+ * format into the PVIDEO registers and sets a "buffer pending" bit;
+ * the hardware latches that buffer at the next vblank, clears the bit, and
+ * D3DDevice_GetOverlayUpdateStatus reports "ready for the next frame". XMV
+ * (the XDK's WMV9 player) waits for exactly that. Nothing flips meanwhile, so
+ * a presenter that only follows flips shows a frozen screen.
+ *
+ * nv2a_overlay_vblank() is the latch (called from the vblank tick); the
+ * presenters ask nv2a_overlay_compose_xrgb() to draw the latched frame over
+ * the framebuffer they are about to show.
+ */
+#ifndef NV2A_OVERLAY_H
+#define NV2A_OVERLAY_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Latch a pending overlay buffer (copying the frame out of guest memory) and
+ * clear its pending bit. Call once per emulated vblank. */
+void nv2a_overlay_vblank(void);
+
+/* Latches so far; changes whenever a new overlay frame arrived. */
+uint64_t nv2a_overlay_seq(void);
+
+/* 1 while an overlay frame is being shown (until the title stops it). */
+int nv2a_overlay_active(void);
+
+/* Draw the latched frame into a 32-bit XRGB8888 image of w x h pixels
+ * (pitch in pixels), scaled to the title's output rectangle, honouring the
+ * colour key when the title enabled it. Returns 1 if anything was drawn. */
+int nv2a_overlay_compose_xrgb(uint32_t *dst, uint32_t w, uint32_t h,
+                              uint32_t pitch_px);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* NV2A_OVERLAY_H */
