{
  "version": "2.0.0",
  // The scripts are bash: on Windows they run in Git Bash (Git for Windows' default install path).
  "windows": {
    "options": {
      "shell": { "executable": "C:/Program Files/Git/bin/bash.exe", "args": ["-c"] }
    }
  },
  "tasks": [
    {
      "label": "Setup (venv + capstone)",
      "type": "shell",
      "command": "scripts/setup.sh",
      "problemMatcher": []
    },
    {
      "label": "Pipeline: parse XBE",
      "type": "shell",
      "command": "scripts/run_pipeline.sh parse",
      "problemMatcher": []
    },
    {
      "label": "Pipeline: disasm",
      "type": "shell",
      "command": "scripts/run_pipeline.sh disasm",
      "problemMatcher": []
    },
    {
      "label": "Pipeline: func_id",
      "type": "shell",
      "command": "scripts/run_pipeline.sh funcid",
      "problemMatcher": []
    },
    {
      "label": "Pipeline: abi_analysis",
      "type": "shell",
      "command": "scripts/run_pipeline.sh abi",
      "problemMatcher": []
    },
    {
      "label": "Pipeline: recomp (generate C)",
      "type": "shell",
      "command": "scripts/run_pipeline.sh recomp",
      "problemMatcher": []
    },
    {
      "label": "Pipeline: all",
      "type": "shell",
      "command": "scripts/run_pipeline.sh",
      "problemMatcher": []
    },
    {
      "label": "Doctor (health report)",
      "type": "shell",
      "command": "scripts/doctor.sh",
      "problemMatcher": []
    },
    {
      "label": "Build (Release)",
      "type": "shell",
      "command": "scripts/build.sh",
      // Windows builds go through CMake Tools, which knows the compiler (kit): its status bar Build, F7, or the
      // task "CMake: build" below.
      "windows": {
        "command": "echo 'On Windows: build with CMake Tools (status bar Build / F7) or the task \"CMake: build\".' >&2; exit 1"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      // CMake Tools' build (configure first if needed): the build type and kit chosen in its status bar.
      "label": "CMake: build",
      "type": "cmake",
      "command": "build",
      "problemMatcher": []
    },
    {
      "label": "Fetch reference repos",
      "type": "shell",
      "command": "scripts/fetch_references.sh",
      "problemMatcher": []
    }
  ]
}
